<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- follows the framework span of the two packages it sits between -->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet -->
		<PackageId>Xen.Utils.AspnetAuthorizationHelper.Minting</PackageId>
		<Version>1.0.0</Version>
		<Authors>Juraj Ahel</Authors>
		<Description>Binds Xen.Utils.ApiKeyMinting to an app-internal auth standard: minted keys become app-internal claims, policies become mintable permissions, and key hashes are derived from the api key standard so they cannot drift from what the authentication handler emits.</Description>
		<PackageTags>api;security;authentication;authorization;apikey</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<Deterministic>true</Deterministic>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup>
		<!--This entry needs to exist in nuget.config-->
		<NugetSourceName>github_vbc_proteomics</NugetSourceName>
		<!--This env var needs to exist and have a properly formatted value-->
		<NugetApiKeyEnvVar>TOKEN_GITHUB_NUGET_VBCPROTEOMICS</NugetApiKeyEnvVar>
	</PropertyGroup>

	<!--TODO: use this mechanism only for devel, to a separate repo. Use github actions on tagged version for publishing the actual versioned nuget pkg-->
	<!-- publish nuget package per right-click -->
	<!-- set up the PAT (Personal access token) of a user with access to the repo to env var TOKEN_GITHUB_NUGET_VBCPROTEOMICS -->
	<Target Name="NugetPush" AfterTargets="Pack" Condition="'$(Configuration)' == 'Debug'">
		<Exec Command="dotnet pack --configuration Release" />
		<Exec Command="dotnet nuget push $(PackageOutputPath)$(PackageId).$(Version).nupkg --source $(NugetSourceName) --api-key %$(NugetApiKeyEnvVar)% --skip-duplicate" />
	</Target>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!--
	    Both dependencies come from a feed rather than a project reference: neither lives in this repository, and
	    this package exists only to join them.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.1" />
		<PackageReference Include="Xen.Utils.ApiKeyMinting" Version="1.0.0" />
		<PackageReference Include="Xen.Utils.AspnetAuthorizationHelper" Version="0.2.0" />
	</ItemGroup>

</Project>
